{% extends 'frontend/layout.html.twig' %}

{% block title %}Eventos{% endblock %}

{% block contenido %}

<div class="container py-4">

    <div class="text-center mb-5">
        <h2 class="fw-bold">Nuestros eventos</h2>
        <p class="text-muted">
            Conocé los eventos y sus horarios.
        </p>
    </div>

    <div class="row g-4">

        {% for evento in eventos %}

            <div class="col-md-6 col-lg-4">

                <div class="card evento-card h-100 border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="horario-evento mb-3">
                            <i class="bi bi-clock"></i>
                            {{ evento.hora|date('H:i') }}
                            -
                            {{ evento.horaFinalizacion|date('H:i') }}
                        </div>

                        {% include 'evento/_card.html.twig' %}

                    </div>

                </div>

            </div>

        {% else %}

            <div class="col-12 text-center py-5">
                <h4>No hay eventos disponibles</h4>
                <p class="text-muted">
                    Próximamente publicaremos nuevos eventos.
                </p>
            </div>

        {% endfor %}

    </div>

</div>

{% endblock %}