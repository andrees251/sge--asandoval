
{% extends 'admin/layout-admin.html.twig' %}

{% block title %}
    Nuevo Disertante
{% endblock %}

{% block body %}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="mb-4">
                <h2 class="fw-bold text-primary">
                    <i class="bi bi-person-plus me-2"></i>
                    Nuevo Disertante
                </h2>

                <p class="text-muted mb-0">
                    Completá los datos para registrar un nuevo disertante.
                </p>
            </div>

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-primary text-white p-3">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-person-badge me-2"></i>
                        Datos del disertante
                    </h5>
                </div>

                <div class="card-body p-4">

                    {{ form_start(form) }}

                    <div class="mb-3">
                        {{ form_label(form.nombre, 'Nombre', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.nombre, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.nombre) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.apellido, 'Apellido', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.apellido, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.apellido) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.biografia, 'Biografía', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.biografia, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.biografia) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.telefono, 'Teléfono', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.telefono, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.telefono) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.direccion, 'Dirección', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.direccion, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.direccion) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.url, 'Página web', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.url, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.url) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.email, 'Correo electrónico', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.email) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.twitter, 'Twitter', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.twitter, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.twitter) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.linkedin, 'LinkedIn', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.linkedin, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.linkedin) }}
                    </div>

                    <div class="d-flex gap-2 mt-4">

                        <button type="submit" class="btn btn-success rounded-pill px-4">
                            <i class="bi bi-check-circle me-2"></i>
                            Guardar Disertante
                        </button>

                        <a href="{{ path('admin_disertante_listar') }}"
                           class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-arrow-left me-2"></i>
                            Volver
                        </a>

                    </div>

                    {{ form_end(form) }}

                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %}
