
{% extends 'admin/layout-admin.html.twig' %}

{% block title %}
    Nuevo Evento
{% endblock %}

{% block body %}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="mb-4">
                <h2 class="fw-bold text-primary">
                    <i class="bi bi-calendar-plus me-2"></i>
                    Nuevo Evento
                </h2>

                <p class="text-muted mb-0">
                    Completá los datos para registrar un nuevo evento.
                </p>
            </div>

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-primary text-white p-3">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-calendar-event me-2"></i>
                        Datos del evento
                    </h5>
                </div>

                <div class="card-body p-4">

                    {{ form_start(form) }}

                    <div class="mb-3">
                        {{ form_label(form.titulo, 'Título', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.titulo, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.titulo) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.descripcion, 'Descripción', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.descripcion, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.descripcion) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.fecha, 'Fecha', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.fecha, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.fecha) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.hora, 'Hora', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.hora, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.hora) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.duracion, 'Duración', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.duracion, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.duracion) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.idioma, 'Idioma', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.idioma, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.idioma) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.estado, 'Estado', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.estado, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.estado) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.disertante, 'Disertante', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.disertante, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.disertante) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.capacidad, 'Capacidad', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.capacidad, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.capacidad) }}
                    </div>

                    <div class="d-flex gap-2 mt-4">

                        <button type="submit" class="btn btn-success rounded-pill px-4">
                            <i class="bi bi-check-circle me-2"></i>
                            Guardar Evento
                        </button>

                        <a href="{{ path('admin_evento_listar') }}"
                           class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-arrow-left me-2"></i>
                            Volver
                        </a>

                    </div>

                    {{ form_end(form) }}

                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %}
