{% extends 'base.html.twig' %}

{% block title %}Disertante{% endblock %}

{% block body %}
    <h1>Disertante</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ disertante.id }}</td>
            </tr>
            <tr>
                <th>Nombre</th>
                <td>{{ disertante.nombre }}</td>
            </tr>
            <tr>
                <th>Apellido</th>
                <td>{{ disertante.apellido }}</td>
            </tr>
            <tr>
                <th>Biografia</th>
                <td>{{ disertante.biografia }}</td>
            </tr>
            <tr>
                <th>Telefono</th>
                <td>{{ disertante.telefono }}</td>
            </tr>
{#             <tr>
                <th>Calles</th>
                <td>{{ disertante.direccion }}</td>
            </tr> #}
            <tr>
                <th>Url</th>
                <td>{{ disertante.url }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ disertante.email }}</td>
            </tr>
            <tr>
                <th>Twitter</th>
                <td>{{ disertante.twitter }}</td>
            </tr>
            <tr>
                <th>Linkedin</th>
                <td>{{ disertante.linkedin }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path(
        'admin_disertante_listar',
        
        ) }}"
        class="btn btn-info btn-sm"
        >
        ⬅ Volver a Disertantes
    </a>

{#     <a href="{{ path('app_admin_disertante_index') }}">back to list</a>

    <a href="{{ path('app_admin_disertante_edit', {'id': disertante.id}) }}">edit</a>

    {{ include('admin_disertante/_delete_form.html.twig') }} #}
{% endblock %}
