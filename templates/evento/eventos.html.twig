
{% extends 'frontend/layout.html.twig' %}

{% block title %}Eventos{% endblock %}

{% block contenido %}

{% for evento in eventos %}

<div>

    <strong>
        {{ evento.hora|date('H:i') }}
        -
        {{ evento.horaFinalizacion|date('H:i') }}
    </strong>

    <br>

    <a href="{{ path('app_evento_detalle', {'slug': evento.slug}) }}">
        {{ evento.titulo|title }}
    </a>

    <p> {{ evento.descripcion|slice(0,150) }} </p>

</div>

{% endfor %}

{% endblock %}