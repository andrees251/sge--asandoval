{% extends 'admin/layout-admin.html.twig' %}

{% block title %}
    Detalles del Disertante
{% endblock %}

{% block body %}

<div class="container py-4">

    <h1 class="fw-bold text-primary mb-4">
        🎤 Detalles del Disertante
    </h1>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <table class="table table-striped align-middle">

                <tbody>

                    <tr>
                        <th width="25%">Id</th>
                        <td>{{ disertante.id }}</td>
                    </tr>

                    <tr>
                        <th>Nombre</th>
                        <td>{{ disertante.nombre }}</td>
                    </tr>

                    <tr>
                        <th>Apellido</th>
                        <td>{{ disertante.apellido }}</td>
                    </tr>

                    <tr>
                        <th>Biografía</th>
                        <td>{{ disertante.biografia }}</td>
                    </tr>

                    <tr>
                        <th>Teléfono</th>
                        <td>{{ disertante.telefono }}</td>
                    </tr>

                    <tr>
                        <th>URL</th>
                        <td>{{ disertante.url }}</td>
                    </tr>

                    <tr>
                        <th>Email</th>
                        <td>{{ disertante.email }}</td>
                    </tr>

                    <tr>
                        <th>Twitter</th>
                        <td>{{ disertante.twitter }}</td>
                    </tr>

                    <tr>
                        <th>LinkedIn</th>
                        <td>{{ disertante.linkedin }}</td>
                    </tr>

                </tbody>

            </table>

            <a href="{{ path(
                'admin_disertante_listar'
            ) }}"
               class="btn btn-secondary">
                ⬅ Volver a Disertantes
            </a>

        </div>

    </div>

</div>

{% endblock %}
