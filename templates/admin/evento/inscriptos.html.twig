{% extends 'base.html.twig' %}

{% block title %}
    Inscriptos
{% endblock %}

{% block body %}

<div class="container py-4">

    <h1 class="fw-bold text-primary mb-3">
        👥 Inscriptos al Evento
    </h1>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <h4 class="fw-semibold">
                {{ evento.titulo|title }}
            </h4>

            <p class="text-muted mb-2">
                Idioma: {{ evento.idioma }}
            </p>

            <span class="badge bg-primary fs-6">
                Total de inscriptos: {{ evento.usuarios|length }}
            </span>

        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>DNI</th>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                </tr>
                </thead>

                <tbody>

                {% for usuario in evento.usuarios %}

                    <tr>

                        <td>
                            {{ loop.index }}
                        </td>

                        <td>
                            {{ usuario.dni }}
                        </td>

                        <td>
                            {{ usuario.nombre }}
                            {{ usuario.apellido }}
                        </td>

                        <td>
                            {{ usuario.telefono }}
                        </td>

                        <td>
                            {{ usuario.email }}
                        </td>

                    </tr>

                {% else %}

                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            No hay usuarios inscriptos.
                        </td>
                    </tr>

                {% endfor %}

                </tbody>

            </table>

        </div>
    </div>

    <div class="mt-4">

        <a href="{{ path(
            'admin_evento_listar'
        ) }}"
           class="btn btn-primary">
            ⬅ Volver a Eventos
        </a>

    </div>

</div>

{% endblock %}