{% extends 'frontend/layout.html.twig' %}

{% block title %}
    Eventos
{% endblock %}

{% block contenido %}

{% for mensaje in app.flashes('info') %}

    <div class="alert alert-info">
        {{ mensaje }}
    </div>

{% endfor %}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold text-primary">
            🎤 Sistema de Gestión de Eventos
        </h1>

        <p class="lead text-muted">
            Próximos eventos disponibles
        </p>
    </div>

    <div class="row">

        <div class="col-md-6">

            {% for evento in eventosCol1 %}

                <div class="mb-4">
                    {% include 'evento/_card.html.twig' %}
                </div>

            {% else %}

                <div class="alert alert-warning">
                    No hay eventos disponibles.
                </div>

            {% endfor %}

        </div>

        <div class="col-md-6">

            {% for evento in eventosCol2 %}

                <div class="mb-4">
                    {% include 'evento/_card.html.twig' %}
                </div>

            {% else %}

                <div class="alert alert-warning">
                    No hay eventos disponibles.
                </div>

            {% endfor %}

        </div>

    </div>

</div>

{% endblock %}