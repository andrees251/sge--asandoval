{% extends 'admin/layout-admin.html.twig' %}

{% block title %}
    Gestión de Disertantes
{% endblock %}

{% block body %}
{% for mensaje in app.flashes('success') %}

    <div class="alert alert-success">

        {{ mensaje }}

    </div>

{% endfor %}



    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Telefono</th>
                <th>Email</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        {% for disertante in disertantes %}
            <tr>
                <td>{{ disertante.id }}</td>
                <td>{{ disertante.nombre }}</td>
                <td>{{ disertante.apellido }}</td>
                <td>{{ disertante.telefono }}</td>
                <td>{{ disertante.email }}</td>

                <td>
                    <a
                        href="{{ path(
                            'admin_disertante_detalles',
                            {id: disertante.id}
                        ) }}"
                        class="btn btn-info btn-sm"
                    >
                        Detalles
                    </a>

                </td>
            </tr>
        {% else %}
            <tr>
                <li colspan="11">No posee disertantes</li>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {# <a href="{{ path('app_admin_disertante_new') }}">Crear Disertante</a> #}
{% endblock %}
