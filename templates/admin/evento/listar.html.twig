{% extends 'admin/layout-admin.html.twig' %}

{% block title %}
    Gestión de Eventos
{% endblock %}

{% block body %}

{% for mensaje in app.flashes('success') %}

    <div class="alert alert-success shadow-sm">
        {{ mensaje }}
    </div>

{% endfor %}

<div class="container py-4">

    <h1 class="fw-bold text-primary mb-4">
        Gestión de Eventos
    </h1>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">
                <tr>
                    <th>Fecha/Hora</th>
                    <th>Título</th>
                    <th>Idioma</th>
                    <th>Estado</th>
                    <th>Inscriptos</th>
                    <th>Acciones</th>
                </tr>
                </thead>

                <tbody>

                {% for evento in eventos %}

                    <tr>

                        <td>
                            {{ evento.fecha|date('d/m/Y') }}
                            <br>
                            <small class="text-muted">
                                {{ evento.hora|date('H:i') }}
                            </small>
                        </td>

                        <td>
                            {{ evento.titulo }}
                        </td>

                        <td>
                            {{ evento.idioma }}
                        </td>

                        <td>

                            {% if evento.estado == 'Activo' %}
                                <span class="badge bg-success">
                                    {{ evento.estado }}
                                </span>
                            {% else %}
                                <span class="badge bg-secondary">
                                    {{ evento.estado }}
                                </span>
                            {% endif %}

                        </td>

                        <td>
                            <span class="badge bg-primary">
                                {{ evento.usuarios|length }}
                            </span>
                        </td>

                        <td>

                            <a
                                href="{{ path(
                                    'admin_evento_inscriptos',
                                    {id: evento.id}
                                ) }}"
                                class="btn btn-primary btn-sm"
                            >
                                👥 Inscriptos
                            </a>

                            <a
                                href="{{ path(
                                    'admin_evento_borrar',
                                    {id: evento.id}
                                ) }}"
                                class="btn btn-danger btn-sm"
                            >
                                🗑️ Borrar
                            </a>

                        </td>

                    </tr>

                {% else %}

                    <tr>
                        <td colspan="6"
                            class="text-center text-muted">
                            No existe ningún evento.
                        </td>
                    </tr>

                {% endfor %}

                </tbody>

            </table>

            <a href="{{ path('admin_evento_nuevo') }}"
               class="btn btn-success">
                ➕ Nuevo Evento
            </a>

        </div>

    </div>

</div>

{% endblock %}