{% extends 'base.html.twig' %}

{% block title %}
Nuevo Evento
{% endblock %}

{% block body %}
    

    <div class="container mt-4"> 

    
        <div>
            <h1>Nuevo Evento</h1>

            {{ form_start(form) }}

                {{form_row(form.titulo)}}
                {{form_row(form.descripcion)}}
                {{form_row(form.fecha)}}
                {{form_row(form.hora)}}
                {{form_row(form.duracion)}}
                {{form_row(form.idioma)}}
                {{form_row(form.estado)}}
                {{form_row(form.disertante)}}

                <button
                type="submit"
                class="btn btn-primary"
                >
                Guardar Evento
                </button>

            {{ form_end(form) }}    
        </div>

        <div>
            <a href="{{ path('admin_evento_listar') }}"
            class="btn btn-success d-inline-block w-auto">
                Volver
            </a>
        </div>

    </div>




{% endblock %}