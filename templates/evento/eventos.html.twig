
{% extends 'frontend/layout.html.twig' %}

{% block title %}Eventos{% endblock %}

{% block contenido %}

<div class="container py-5">

    <div class="text-center mb-5">
        <h2 class="fw-bold display-6">Nuestros eventos</h2>
        <p class="text-muted">
    Eventos: {{ eventos|length }}
    | Página: {{ paginaActual }} de {{ totalPaginas }}
</p>
        <p class="text-muted">
            Conocé los eventos disponibles y sus horarios.
        </p>
    </div>

    <div class="row g-4">

        {% for evento in eventos %}

            {% set cupos = disponibilidadService.obtenerMensaje(evento) %}

            <div class="col-md-6 col-lg-4">

                <div class="card h-100 border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="mb-3">
                            <span class="badge bg-primary-subtle text-primary px-3 py-2">
                                <i class="bi bi-people me-1"></i>
                                {{ cupos }}
                            </span>
                        </div>

                        <div class="d-flex align-items-center text-muted mb-3">
                            <i class="bi bi-clock text-primary fs-5 me-2"></i>
                            <span>
                                {{ evento.hora|date('H:i') }}
                                -
                                {{ evento.horaFinalizacion|date('H:i') }}
                            </span>
                        </div>

                        {% include 'evento/_card.html.twig' %}

                    </div>

                </div>

            </div>

        {% else %}

            <div class="col-12">
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x text-muted display-4"></i>
                    <h4 class="fw-bold mt-3">No hay eventos disponibles</h4>
                    <p class="text-muted mb-0">
                        Próximamente publicaremos nuevos eventos.
                    </p>
                </div>
            </div>

        {% endfor %}

    </div>

    {# PAGINACIÓN #}
    {% if totalPaginas > 1 %}

        <nav aria-label="Paginación de eventos" class="mt-5">
            <ul class="pagination justify-content-center">

                <li class="page-item {{ paginaActual == 1 ? 'disabled' : '' }}">
                    <a class="page-link"
                       href="{{ path('app_eventos', {'page': paginaActual - 1}) }}">
                        Anterior
                    </a>
                </li>

                {% for numero in 1..totalPaginas %}

                    <li class="page-item {{ numero == paginaActual ? 'active' : '' }}">
                        <a class="page-link"
                           href="{{ path('app_eventos', {'page': numero}) }}">
                            {{ numero }}
                        </a>
                    </li>

                {% endfor %}

                <li class="page-item {{ paginaActual == totalPaginas ? 'disabled' : '' }}">
                    <a class="page-link"
                       href="{{ path('app_eventos', {'page': paginaActual + 1}) }}">
                        Siguiente
                    </a>
                </li>

            </ul>
        </nav>

    {% endif %}

</div>

{% endblock %}
