
{% extends 'frontend/layout.html.twig' %}

{% block body %}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white py-3">
                    <h2 class="mb-0 fw-bold">
                        {{ evento.titulo|title }}
                    </h2>
                </div>

                <div class="card-body p-4">

                    <h5 class="text-secondary mb-3">
                        Descripción del evento
                    </h5>

                    <p class="text-muted">
                        {{ evento.descripcion|slice(0,150) }}
                    </p>

                    <hr>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-calendar-event text-primary fs-4"></i>
                                <div>
                                    <small class="text-muted d-block">Fecha</small>
                                    <strong>
                                        {{ evento.fecha|date('d/m/Y') }}
                                    </strong>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-clock text-primary fs-4"></i>
                                <div>
                                    <small class="text-muted d-block">Horario</small>
                                    <strong>
                                        {{ evento.hora|date('H:i') }}
                                        -
                                        {{ evento.horaFinalizacion|date('H:i') }}
                                    </strong>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-translate text-primary fs-4"></i>
                                <div>
                                    <small class="text-muted d-block">Idioma</small>
                                    <strong>{{ evento.idioma }}</strong>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-person-badge text-primary fs-4"></i>
                                <div>
                                    <small class="text-muted d-block">Disertante</small>
                                    <strong>
                                        <a href="{{ path('app_disertantes') }}"
                                           class="text-decoration-none">
                                            {{ evento.disertante }}
                                        </a>
                                    </strong>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

                <div class="card-footer bg-white p-3">
                    <a href="{{ path('app_eventos') }}"
                       class="btn btn-outline-primary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i>
                        Volver a eventos
                    </a>
                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %}
